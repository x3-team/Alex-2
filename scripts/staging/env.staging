APP_NAME="ALEX2 staging"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://__STAGING_DOMAIN__
APP_DOCTORS_HOST=__STAGING_DOC_DOMAIN__

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alex2_staging
DB_USERNAME=alex2_staging
DB_PASSWORD=

SESSION_DOMAIN=null
SESSION_COOKIE=alex2_staging_session
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

# Почта только в storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@alexallergotest.ru"
MAIL_FROM_NAME="ALEX2 staging"
LEADS_MAIL_TO=

# Метрика и GA4 на staging не грузятся, серверная отправка выключена
ANALYTICS_CLIENT_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=
METRIKA_COUNTER_ID=
METRIKA_OAUTH_TOKEN=
ANALYTICS_EXPORT_DOCTOR_APPOINTMENT=false
ANALYTICS_EXPORT_TEST_ORDER=false

# SSR выключен: ziggy.js для SSR знает только боевые домены
INERTIA_SSR_ENABLED=false

# Интеграции — только тестовые стенды (GitHub secrets STAGING_*). Пусто — наружу ничего не уходит.
ORDER_BRIDGE_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
MEDMIS_BASE_URL=
MEDMIS_LOGIN=
MEDMIS_PASSWORD=
DNKOM_URL=
DNKOM_PASSWORD=
